# .env.tradier — SECONDARY (Tradier) instance secrets.
# Copy to .env.tradier on the VM and fill in. NOT committed (gitignored).
# Referenced by the `tradier` service in docker-compose.yml.
#
# NOTE: no DISCORD_TOKEN — this instance runs NO Discord gateway
# (discord_listener_enabled=false). It ingests via the primary's HTTP mirror.

# ── Tradier brokerage creds ──
# Sandbox token ≠ production token. Match [tradier] sandbox in config.tradier.ini:
#   sandbox=true  → use a SANDBOX token here
#   sandbox=false → use a PRODUCTION token here (and only after a green probe)
TRADIER_TOKEN=
TRADIER_ACCOUNT_ID=

# ── Optional: GCP creds for Vertex/vision (only if you re-enable ai_parser/
# signals on this instance; both are OFF in config.tradier.ini by default) ──
# GOOGLE_APPLICATION_CREDENTIALS=/app/keys/vertex-sa.json

# NOTE: no TUNNEL_TOKEN here — the secondary dashboard is reachable over SSH at
# http://127.0.0.1:8002 on the VM. Add a cloudflared config only if you want it
# publicly exposed under its own hostname.
