# ============================================================================
#  TradeRelay — environment config.  Copy to .env and fill the REQUIRED block.
#      cp .env.example .env
#  Everything below "OPTIONAL" has a working default — leave blank to skip.
# ============================================================================

# ── REQUIRED ────────────────────────────────────────────────────────────────

# Discord BOT token (official bot, "Message Content Intent" enabled).
# Create at https://discord.com/developers/applications
DISCORD_TOKEN=

# Which broker to trade through: public | ibkr | tradier | lime
BROKER=public

# Broker credentials — fill ONLY the block for your BROKER above.
#   public.com
PUBLIC_API_KEY=
PUBLIC_ACCOUNT_NUMBER=
#   tradier  (sandbox token works for paper testing)
TRADIER_ACCESS_TOKEN=
TRADIER_ACCOUNT_ID=
#   lime  (OAuth2 password grant — the account password IS a credential here).
#   ⚠ Lime has no sandbox host: demo and live accounts share api.lime.co, so
#     LIME_ACCOUNT_NUMBER is the ONLY thing separating paper from real money.
LIME_USERNAME=
LIME_PASSWORD=
LIME_CLIENT_ID=
LIME_CLIENT_SECRET=
LIME_ACCOUNT_NUMBER=
#   ibkr — creds are NOT set here; IB Gateway/IBC handles login.
#          Just point the app at the running Gateway:
IBKR_HOST=127.0.0.1
IBKR_PORT=4002

# ── OPTIONAL ────────────────────────────────────────────────────────────────

# Anthropic key — enables the AI fallback parser + confidence scorer.
# Without it the fast regex parser still runs; AI features auto-disable.
ANTHROPIC_API_KEY=

# ---- Discord forwarder (OPTIONAL) ----
# Relays messages from servers your BOT can't join, using your PERSONAL Discord
# account token.  ⚠️  WARNING: automating a user account ("self-bot") VIOLATES
# Discord's Terms of Service and can get your account banned. OFF by default.
# Only set these if you understand and accept that risk. The official-bot path
# (DISCORD_TOKEN above) needs none of this.
DISCORD_USER_TOKEN=
DISCORD_WEBHOOK_URL=

# ---- Remote access / hardening (OPTIONAL, advanced) ----
# Cloudflare Tunnel token — enables the `cloudflared` compose profile so the
# dashboard is reachable without opening a port. Leave blank for localhost only.
TUNNEL_TOKEN=
# App-layer auth (see docs). Leave blank for a local-only setup.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_ALLOWED_EMAILS=
DASHBOARD_API_KEY=
CORS_ALLOW_ORIGINS=

# ---- Grafana Cloud metrics (OPTIONAL) ----
# Enables the `grafana` compose profile: an Alloy sidecar scrapes /metrics off
# both bots and remote_writes to Grafana Cloud. Leave blank to skip entirely.
# Values come from Grafana Cloud → your stack → Prometheus → "Send Metrics".
# The token must be a Cloud Access Policy token (`glc_`, scope metrics:write) —
# a `glsa_` service-account token is for the Grafana API and will 401.
GRAFANA_CLOUD_PROM_URL=
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_TOKEN=
